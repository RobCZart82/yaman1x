+void an1x_state::lcd_control_w(u8 data)
+{
+    using E = yamanix::LcdBus::Event;
+    switch (m_lcd_bus.control(data)) {
+    case E::status_read:
+        m_lcd_bus.read_latch = m_lcd->status_r();
+        if (m_lcd_bus.read_latch & 0x80) ++m_lcd_busy_reads; else ++m_lcd_ready_reads;
+        break;
+    case E::data_read: m_lcd_bus.read_latch = m_lcd->dr_r(); break;
+    case E::instruction_write:
+        if (m_lcd_commands++ < 128) logerror("YAMANIX LCD command pc=%06x data=%02x\n", m_maincpu->pc(), m_lcd_bus.output_data());
+        m_lcd->ir_w(m_lcd_bus.output_data()); break;
+    case E::data_write:
+        if (m_lcd_data++ < 256) logerror("YAMANIX LCD data pc=%06x data=%02x\n", m_maincpu->pc(), m_lcd_bus.output_data());
+        m_lcd->dr_w(m_lcd_bus.output_data()); break;
+    case E::none: break;
+    }
 }
 
