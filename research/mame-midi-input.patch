@@ -201,8 +204,17 @@
 
 void an1x_state::dsp_trace_end()
 {
+    logerror("YAMANIX MIDI_RX transitions=%llu hardware_validated=0\n", (unsigned long long)m_midi_rx_edges);
     end_bridge();
     logerror("YAMANIX DSP_END events=%llu dropped=%llu\n", (unsigned long long)m_dsp_events, (unsigned long long)m_dsp_dropped);
+}
+
+void an1x_state::midi_rx_w(int state)
+{
+	if (m_midi_rx_level >= 0 && state != m_midi_rx_level)
+		++m_midi_rx_edges;
+	m_midi_rx_level = state;
+	m_maincpu->sci_rx_w<0>(state);
 }
 
