+
+// YamANIx research instrumentation: observes accesses without supplying fake peripherals.
+void an1x_state::machine_start()
+{
+    auto &space = m_maincpu->space(AS_PROGRAM);
+    space.set_log_unmap(false);
+    m_read_trace = space.install_read_tap(0x300000, 0xffffff, "yamanix_read",
+        [this](offs_t address, u16 &data, u16 mask) {
+            if (machine().side_effects_disabled()) return;
+            if (m_reads.size() < 512 && m_reads.insert(address).second)
+                logerror("YAMANIX READ pc=%06x address=%06x data=%04x mask=%04x\n", m_maincpu->pc(), address, data, mask);
+        });
+    m_write_trace = space.install_write_tap(0x300000, 0xffffff, "yamanix_write",
+        [this](offs_t address, u16 &data, u16 mask) {
+            if (machine().side_effects_disabled()) return;
+            if (m_writes.size() < 512 && m_writes.insert(address).second)
+                logerror("YAMANIX WRITE pc=%06x address=%06x data=%04x mask=%04x\n", m_maincpu->pc(), address, data, mask);
+        });
+    auto *timer = timer_alloc(FUNC(an1x_state::trace_tick), this);
+    timer->adjust(attotime::zero, 0, attotime::from_msec(10));
+    logerror("YAMANIX research harness: H8 active; LCD omitted; VOP3/MEG integration incomplete\n");
+}
+
+TIMER_CALLBACK_MEMBER(an1x_state::trace_tick)
+{
+    if (m_ticks < 101)
+        logerror("YAMANIX PC tick=%u pc=%06x\n", m_ticks, m_maincpu->pc());
+    ++m_ticks;
+}
 
