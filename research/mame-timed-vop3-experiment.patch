+void an1x_state::advance_bridge()
+{
+    if (!m_bridge || !m_sample_clock_enabled) return;
+    const u64 now_ns = machine().time().as_ticks(1000000000);
+    if (now_ns < m_bridge_origin_ns) fatalerror("MAME time moved before VOP3 bridge origin");
+    const u64 target_ns = now_ns - m_bridge_origin_ns;
+    while (m_bridge_time_ns < target_ns) {
+        u64 next_ns = target_ns;
+        if (next_ns - m_bridge_time_ns > 80000000)
+            next_ns = m_bridge_time_ns + 80000000;
+        if (m_bridge_advance(m_bridge, next_ns))
+            fatalerror("VOP3 sample-clock advance rejected");
+        m_bridge_time_ns = next_ns;
+    }
+}
