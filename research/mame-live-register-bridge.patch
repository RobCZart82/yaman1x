+// macOS research target only; ABI and core are separate from the MAME executable.
+void an1x_state::start_bridge()
+{
+    const char *path = std::getenv("YAMANIX_VOP3_BRIDGE");
+    if (!path || !*path) { logerror("YAMANIX BRIDGE state=disabled\n"); return; }
+    if (!m_contract_enabled) fatalerror("Live register bridge requires explicit firmware-contract profile");
+    m_bridge_library = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+    if (!m_bridge_library) fatalerror("Cannot load YamANIx bridge: %s", dlerror());
+    auto symbol = [this](const char *name) {
+        auto ptr = dlsym(m_bridge_library, name);
+        if (!ptr) fatalerror("Missing YamANIx bridge symbol: %s", name);
+        return ptr;
+    };
+    auto version = reinterpret_cast<decltype(&yamanix_vop3_abi_version)>(symbol("yamanix_vop3_abi_version"));
+    if (version() != 1) fatalerror("Incompatible YamANIx bridge ABI");
+    auto create = reinterpret_cast<decltype(&yamanix_vop3_create)>(symbol("yamanix_vop3_create"));
+    m_bridge_destroy = reinterpret_cast<decltype(m_bridge_destroy)>(symbol("yamanix_vop3_destroy"));
+    m_bridge_write = reinterpret_cast<decltype(m_bridge_write)>(symbol("yamanix_vop3_write"));
+    m_bridge_read = reinterpret_cast<decltype(m_bridge_read)>(symbol("yamanix_vop3_read"));
+    m_bridge_snapshot = reinterpret_cast<decltype(m_bridge_snapshot)>(symbol("yamanix_vop3_snapshot"));
+    m_bridge_metrics = reinterpret_cast<decltype(m_bridge_metrics)>(symbol("yamanix_vop3_get_metrics"));
+    m_bridge = create();
+    if (!m_bridge) fatalerror("Cannot create YamANIx VOP3 pair");
+    logerror("YAMANIX BRIDGE state=live-register-only abi=1 dsp_samples=0 hardware_validated=0\n");
+}
+
+void an1x_state::end_bridge()
+{
+    if (!m_bridge) return;
+    std::array<uint8_t, 14340> bytes;
+    yamanix_vop3_metrics metrics{};
+    if (m_bridge_snapshot(m_bridge, bytes.data(), bytes.size()) || m_bridge_metrics(m_bridge, &metrics))
+        fatalerror("Cannot snapshot YamANIx bridge");
+    std::ofstream output("live-vop3-state.bin", std::ios::binary);
+    output.write(reinterpret_cast<const char *>(bytes.data()), bytes.size());
+    output.close();
+    if (!output) fatalerror("Cannot save YamANIx live state");
+    for (unsigned chip = 0; chip < 2; ++chip)
+        logerror("YAMANIX BRIDGE_END chip=%u writes=%llu reads=%llu unsupported_reads=%llu sample_passes=%llu\n", chip,
+            (unsigned long long)metrics.writes[chip], (unsigned long long)metrics.reads[chip],
+            (unsigned long long)metrics.unsupported_reads[chip], (unsigned long long)metrics.sample_passes[chip]);
+    m_bridge_destroy(m_bridge);
+    m_bridge = nullptr;
+    dlclose(m_bridge_library);
+    m_bridge_library = nullptr;
 }
 
