+
+void an1x_state::dsp_event(char op, offs_t address, u16 data, u16 mask)
+{
+    int chip;
+    offs_t base;
+    if (address >= 0x440000 && address < 0x440100) { chip = 0; base = 0x440000; }
+    else if (address >= 0x480000 && address < 0x480100) { chip = 1; base = 0x480000; }
+    else return;
+    const u64 seq = m_dsp_events++;
+    if (seq >= 200000) { ++m_dsp_dropped; return; }
+    logerror("YAMANIX DSP seq=%llu time_ns=%llu op=%c chip=%d reg=%02x data=%04x mask=%04x pc=%06x\n",
+        (unsigned long long)seq, (unsigned long long)machine().time().as_ticks(1000000000),
+        op, chip, (address - base) / 2, data, mask, m_maincpu->pc());
+}
+
+void an1x_state::dsp_trace_end()
+{
+    logerror("YAMANIX DSP_END events=%llu dropped=%llu\n", (unsigned long long)m_dsp_events, (unsigned long long)m_dsp_dropped);
 }
 
